{
  "name": "wallriderlang-site",
  "version": "0.1.2",
  "private": true,
  "description": "WallRiderLang documentation site and browser identity spine",
  "type": "module",
  "license": "Apache-2.0",
  "repository": { "type": "git", "url": "git+https://github.com/c-u-l8er/WRL.git" },
  "exports": { ".": "./wrl.js" },
  "files": ["wrl.js"],
  "scripts": {
    "test": "node test/conformance.mjs && node test/entry-point-regression.mjs && node forge-probe/live-local-bundle/verify.mjs forge-probe/live-local-bundle",
